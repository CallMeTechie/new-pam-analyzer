{
  "name": "@pam/server",
  "version": "0.6.0",
  "description": "PAM Analyzer server: API, storage and web delivery",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@pam/core": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "~0.45.2",
    "fflate": "~0.8.3",
    "hono": "^4.13.19",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "~0.31.11",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
